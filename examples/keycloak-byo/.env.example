#
# Copy to .env and fill in. See docs/scenarios/keycloak-byo.md.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a && nix run .#check-oidc
#   docker compose up

# Ends at /realms/<realm>. Must match what Keycloak announces about itself,
# and resolve to the same host for the browser AND this container.
QGIS_DESKTOP_OIDC_ISSUER_URL=https://sso.example.com/realms/gis

# The confidential client you created (step 2).
QGIS_DESKTOP_OIDC_CLIENT_ID=qgis-desktop

# Where users open the desktop, plus /oauth2/callback. Must be registered on
# the client as a Valid redirect URI, exactly, including scheme and port.
QGIS_DESKTOP_OIDC_REDIRECT_URL=https://qgis.example.com/oauth2/callback

# Realm role a user must hold. Leaving this empty means anyone your Keycloak
# can authenticate gets a desktop.
QGIS_DESKTOP_OIDC_ALLOWED_ROLES=qgis-user

# 1 when something else terminates TLS in front of the container.
QGIS_DESKTOP_OIDC_REVERSE_PROXY=0

# 1 once the session is served over https, so the cookie is marked Secure.
QGIS_DESKTOP_OIDC_COOKIE_SECURE=0

VNC_RESOLUTION=1600x900

# The client secret is NOT set here — it goes in secrets/oidc-client-secret so
# it stays out of `docker inspect` and out of your shell history.
